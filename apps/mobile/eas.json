{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-moto-g60": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GF_TARGET_DEVICE": "moto-g60"
      }
    },
    "preview-iphone": {
      "extends": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "GF_TARGET_DEVICE": "iphone-17-pro"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
